{
  "name": "api-transactions",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de transactions bancaires fictives - Groupe 5 - Theme 6",
  "main": "src/server.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "load": "node src/scripts/load-csv.js",
    "load:local": "node --env-file-if-exists=../.env src/scripts/load-csv.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:api": "jest tests/api",
    "test:integration": "jest tests/integration --runInBand",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/scripts/**"
    ]
  }
}
