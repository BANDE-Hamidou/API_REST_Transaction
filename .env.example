# Copier ce fichier en .env :   Copy-Item .env.example .env
# Valeurs d'EXEMPLE pour un poste de développement : aucun secret réel.
# Si un port est déjà utilisé sur votre machine, changez seulement le port *_HOST_PORT.

POSTGRES_USER=transactions
POSTGRES_PASSWORD=transactions
POSTGRES_DB=transactions
POSTGRES_HOST_PORT=5432

API_HOST_PORT=3000
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Utilisé seulement pour lancer l'API hors Docker (cd api ; npm run dev)
PGHOST=localhost
